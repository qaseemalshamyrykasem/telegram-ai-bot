# ==========================================
# إعدادات بوت تليجرام - الذكاء الاصطناعي
# ==========================================

# توكن بوت التليجرام (من @BotFather)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE

# عنوان خادم الـ API (اختياري - للـ Webhook)
# إذا كنت تستخدم Render، ضع رابط تطبيقك هنا
WEBHOOK_URL=https://your-app-name.onrender.com

# منفذ الخادم
PORT=3000

# وضع التشغيل
# polling = يسحب الرسائل تلقائياً (أسهل للبداية)
# webhook = يستقبل الرسائل فوراً (أفضل للإنتاج)
BOT_MODE=polling

# رسالة الترحيب
WELCOME_MESSAGE=مرحباً! أنا بوت ذكاء اصطناعي 🤖\nاسألني أي سؤال وسأجيبك!

# الحد الأقصى لطول الرسالة الواحدة
MAX_MESSAGE_LENGTH=4096
